{
  // Hugo builds into ./public; the Worker serves static assets and negotiates Markdown.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jims-blog",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/blogs/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "previews": {},
  // Gives each `wrangler versions upload` its own shareable preview URL.
  "preview_urls": true,
  "workers_dev": true,
  // Custom domains. Kept here so `wrangler deploy` matches what's attached in the dashboard.
  "routes": [
    { "pattern": "jimbobbennett.dev", "custom_domain": true },
    { "pattern": "www.jimbobbennett.dev", "custom_domain": true }
  ]
}
